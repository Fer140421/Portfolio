  },
  {
    title: "Sistema de Control de Activos",
    description: "Sistema web para el control de activos de mantenimiento de una empresa ficticia. Primer proyecto full stack desarrollado como parte de la materia Taller I.",
    stack: ["Angular 16", "Spring Boot", "PostgreSQL", "Bootstrap"],
    period: "Sep – Dic 2023",
    type: "Universitario",
    github: "#",
    demo: "#",
  },
  {
  title: "Página Web Evolución del Desarrollo Web",
  description: "Sitio web educativo colaborativo que muestra la evolución del desarrollo web desde los años 90 hasta la actualidad, desarrollado para la materia de inglés del Instituto de Idiomas ULI.",
  stack: ["HTML", "CSS", "JavaScript"],
  period: "Nov – Dic 2025",
  type: "Colaborativo",
  github: "#",
  demo: "https://uliproject.vercel.app/",
},
];

const typeBadgeColor: Record<string, string> = {
  "Profesional":        "text-emerald-400 bg-emerald-400/10 border-emerald-400/20",
  "Proyecto de Grado":  "text-purple-400  bg-purple-400/10  border-purple-400/20",
  "Simulación Laboral": "text-yellow-400  bg-yellow-400/10  border-yellow-400/20",
  "Universitario":      "text-blue-400    bg-blue-400/10    border-blue-400/20",
  "Personal":           "text-electric-blue bg-electric-blue/10 border-electric-blue/20",
};
---

<section class="py-20 lg:py-32" id="proyectos">
  <div class="container mx-auto px-4">

    <h2 class="text-3xl lg:text-4xl font-bold text-white mb-12 text-center">
      <span id="projects-typewriter"></span><span id="projects-cursor" class="projects-cursor">▌</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map(project => (
        <div class="group relative flex flex-col h-full bg-gray-900/50 border border-gray-800 rounded-lg overflow-hidden transition-all duration-300 hover:border-electric-blue/50 hover:shadow-electric-glow hover:-translate-y-1">
          <div class="p-6 flex-grow">

            <!-- Tipo + período -->
            <div class="flex items-center justify-between mb-3">
              <span class={`text-xs font-semibold px-2 py-0.5 rounded-full border ${typeBadgeColor[project.type] ?? typeBadgeColor["Personal"]}`}>
                {project.type}
              </span>
              <span class="text-xs text-gray-600">{project.period}</span>
            </div>

            <h3 class="text-lg font-bold text-white mb-2 leading-tight">{project.title}</h3>
            <p class="text-gray-400 text-sm mb-4">{project.description}</p>

            <div class="flex flex-wrap gap-2">
              {project.stack.map(tech => (
                <span class="text-xs font-semibold text-electric-blue bg-electric-blue/10 px-2 py-1 rounded-full">{tech}</span>
              ))}
            </div>
          </div>

          <div class="p-6 pt-0 mt-auto flex items-center justify-end gap-4">
            <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-gray-500 transition-colors duration-300 hover:text-electric-blue">
              <GitHubIcon class="w-6 h-6" />
              <span class="sr-only">GitHub</span>
            </a>
            <a href={project.demo} target="_blank" rel="noopener noreferrer" class="text-gray-500 transition-colors duration-300 hover:text-electric-blue">
              <LinkIcon class="w-6 h-6" />
              <span class="sr-only">Demo</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes projects-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
  .projects-cursor {
    display: inline-block;
    color: #00bfff;
    animation: projects-blink 0.75s step-end infinite;
    font-weight: 300;
    margin-left: 1px;
    transition: opacity 0.4s ease;
  }
  .projects-cursor.done {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const TEXT       = "Proyectos Destacados";
  const TYPE_SPEED = 90;

  const el     = document.getElementById("projects-typewriter")!;
  const cursor = document.getElementById("projects-cursor")!;
  let typed    = false;

  function typeTitle() {
    if (typed) return;
    typed = true;
    let i = 0;
    function step() {
      if (i < TEXT.length) {
        el.textContent = TEXT.slice(0, i + 1);
        i++;
        setTimeout(step, TYPE_SPEED);
      } else {
        setTimeout(() => cursor.classList.add("done"), 600);
      }
    }
    step();
  }

  const section = document.getElementById("proyectos")!;
  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) {
        typeTitle();
        observer.disconnect();
      }
    },
    { threshold: 0.3 }
  );
  observer.observe(section);
</script>