import LinkIcon from "./icons/Link.astro";

const projects = [
  {
    title: "Sistema Web Importadora Falumar",
    description: "Sistema de gestión web con tienda en línea, control de inventario, ventas y roles de usuario. Integración de flujos de venta con pre-ventas, apertura/cierre de caja, emisión de notas de venta y escaneo de código de barras. Sistema desplegado y en producción.",
    stack: ["Angular 18", "Spring Boot", "PostgreSQL", "JWT", "Bootstrap"],
    period: "Feb – Ago 2025",
    type: "Profesional",
    github: "#",
    demo: "https://falumar.online/store/home",
  },
  {
    title: "Página Web Sabor a Vino",
    description: "Sitio web desarrollado para la agencia de vinos ficticia 'Sabor a Vino' como proyecto de emprendimiento universitario. Diseño visual atractivo con HTML, CSS y JavaScript puro.",
    stack: ["HTML", "CSS", "JavaScript", "Bootstrap"],
    period: "Ago 2024",
    type: "Profesional",
    github: "#",
    demo: "https://sabor-a-vino.vercel.app/",
  },
  {
  title: "Tienda Online Ropa Urbana",
  description: "Catálogo en línea para emprendimiento de ropa urbana, tienda funcional con visualización de productos, desarrollada como solución digital para el negocio.",
  stack: ["Angular 20", "Firebase"],
  period: "2025",
  type: "Profesional",
  github: "#",
  demo: "https://hypezone.vercel.app/home",
},
{
  title: "Invitación Web Cumpleaños Minnie",
  description: "Invitación digital para cumpleaños de 3 años con temática de Minnie Mouse, sitio estático animado y responsive, entregado como proyecto freelance.",
  stack: ["Astro", "Tailwind CSS"],
  period: "2025",
  type: "Profesional",
  github: "#",
  demo: "https://invitacion-geraldi.vercel.app/",
},
  {
    title: "Sistema ERP Urban Signs",
    description: "Sistema web de categoría ERP para empresa de industria gráfica. Automatización de gestión de pedidos, control de inventarios, activos, cronograma de producción, facturación electrónica y seguimiento de proyectos. Arquitectura backend en capas con principios SOLID.",
    stack: ["Angular 18", "Spring Boot", "PostgreSQL", "Tailwind CSS", "JWT"],
    period: "Mar 2025 – Mar 2026",
    type: "Proyecto de Grado",
    github: "#",
    demo: "#",
  },
  {
    title: "Sistema Web MediCam",
    description: "Prototipo de sistema web orientado a profesionales del área médica, desarrollado en simulación laboral. Interfaces responsivas y componentes reutilizables con consumo de datos mediante JSON Server simulando una API REST.",
    stack: ["Angular 17", "TypeScript", "Bootstrap", "JSON Server"],
    period: "Ago – Sep 2024",
    type: "Simulación Laboral",
    github: "#",
    demo: "#",
  },
  {
    title: "Sistema Académico ETC Tarija",
    description: "Sistema web académico para el Instituto ETC Tarija. Módulos para gestión académica, matriculación, registro de notas y control de pagos. Proyecto universitario de la materia Taller II.",
    stack: ["Angular 18", "Spring Boot", "PostgreSQL", "TypeScript", "Bootstrap"],
    period: "Feb – Dic 2024",
    type: "Universitario",
    github: "#",
    demo: "#",
  },
  {
    title: "App Móvil Cafetería",
    description: "Aplicación móvil para una cafetería ficticia enfocada en la venta de desayunos. Desarrollo completo con frontend móvil, backend y base de datos en la nube.",
    stack: ["Kotlin", "Nest.js", "Firebase"],
    period: "Jun – Jul 2024",
    type: "Universitario",
    github: "#",
