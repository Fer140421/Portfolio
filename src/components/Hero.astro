---
// src/components/Hero.astro
// Coloca tu foto en: public/foto-perfil.jpg (o .png, .webp)
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
  id="inicio"
>
  <div class="absolute inset-0 bg-deep-black z-10">
    <!-- Grid de fondo -->
    <div
      class="absolute inset-0 bg-[linear-gradient(rgba(0,191,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,191,255,0.03)_1px,transparent_1px)] bg-[size:60px_60px]"
    >
    </div>

    <!-- Glow central inferior -->
    <div
      class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[80%] h-[50%] bg-electric-blue/10 blur-[100px] rounded-full"
    >
    </div>

    <!-- Glow superior derecho -->
    <div
      class="absolute -top-20 -right-20 w-96 h-96 bg-electric-blue/5 blur-[120px] rounded-full"
    >
    </div>

    <!-- Orbes flotantes -->
    <div
      class="absolute top-1/4 left-1/4 w-2 h-2 bg-electric-blue/40 rounded-full orb-float"
      style="animation-delay: 0s;"
    >
    </div>
    <div
      class="absolute top-1/3 right-1/3 w-1 h-1 bg-electric-blue/30 rounded-full orb-float"
      style="animation-delay: 1.5s;"
    >
    </div>
    <div
      class="absolute bottom-1/3 left-1/3 w-1.5 h-1.5 bg-electric-blue/20 rounded-full orb-float"
      style="animation-delay: 0.8s;"
    >
    </div>
    <div
      class="absolute top-2/3 right-1/4 w-1 h-1 bg-electric-blue/35 rounded-full orb-float"
      style="animation-delay: 2.2s;"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/6 w-2 h-2 bg-electric-blue/15 rounded-full orb-float"
      style="animation-delay: 3s;"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/5 w-1.5 h-1.5 bg-electric-blue/25 rounded-full orb-float"
      style="animation-delay: 1s;"
    >
    </div>
    <div
      class="absolute top-1/5 right-1/6 w-1 h-1 bg-electric-blue/30 rounded-full orb-float"
      style="animation-delay: 2.5s;"
    >
    </div>
    <div
      class="absolute bottom-2/3 left-2/3 w-2 h-2 bg-electric-blue/20 rounded-full orb-float"
      style="animation-delay: 0.3s;"
    >
    </div>
  </div>

  <div class="relative z-20 w-full max-w-6xl mx-auto px-6 py-24 lg:py-0">
    <div
      class="flex flex-col-reverse lg:flex-row items-center justify-between gap-12 lg:gap-16"
    >
      <!-- ── Texto ── -->
      <div class="text-center lg:text-left flex-1">
        <h1
          class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-wider text-white animate-fade-in-down name-glow"
          style="animation-delay: 200ms;"
        >
          Fernando Camata
        </h1>

        <p
          class="mt-4 text-lg md:text-xl font-medium text-electric-blue animate-fade-in-down"
          style="animation-delay: 400ms;"
        >
          <span id="typewriter"></span><span
            id="cursor"
            class="typewriter-cursor">▌</span
          >
        </p>

        <p
          class="mt-5 max-w-xl text-base md:text-lg text-gray-400 animate-fade-in-up mx-auto lg:mx-0"
          style="animation-delay: 600ms;"
        >
          Enfocado en la creación de sistemas empresariales robustos y
          escalables, desde microservicios hasta dashboards de alta performance.
        </p>

        <div
          class="mt-8 flex items-center justify-center lg:justify-start animate-fade-in-up"
          style="animation-delay: 800ms;"
        >
          <a
            href="/cv/CV-DAVID-CAMATA.pdf"
            download
            class="group inline-flex items-center gap-3 px-8 py-3.5 text-sm font-semibold text-white bg-electric-blue rounded-lg transition-all duration-300 hover:scale-105 hover:shadow-electric-glow-sm"
          >
            <svg
              class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v13m0 0l-4-4m4 4l4-4M3 21h18"></path>
            </svg>
            Descargar CV
          </a>
        </div>
      </div>

      <!-- ── Foto ── -->
      <div
        class="flex-shrink-0 animate-fade-in-down"
        style="animation-delay: 300ms;"
      >
        <div class="relative">
          <!-- Glow detrás de la foto -->
          <div
            class="absolute inset-0 rounded-full bg-electric-blue/20 blur-2xl scale-110"
          >
          </div>

          <!-- Marco con borde azul eléctrico -->
          <div
            class="relative w-52 h-52 md:w-64 md:h-64 lg:w-72 lg:h-72 rounded-full border-2 border-electric-blue/40 p-1 bg-gray-900/50"
          >
            <img
              src="/nano.jpg"
              alt="Fernando Camata"
              class="w-full h-full rounded-full object-cover object-top"
              onerror="this.parentElement.classList.add('photo-fallback')"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Flecha scroll -->
  <div
    id="scroll-hint"
    class="absolute bottom-10 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center gap-3"
  >
    <span class="scroll-label">Desliza</span>
    <div class="scroll-arrow">
      <svg
        class="w-7 h-7"
        fill="none"
        stroke="#00BFFF"
        stroke-width="2.5"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </div>
    <div class="scroll-arrow scroll-arrow--delayed">
      <svg
        class="w-7 h-7"
        fill="none"
        stroke="#00BFFF"
        stroke-width="2.5"
        viewBox="0 0 24 24"
        style="opacity:0.4"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in-down {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-down {
    animation: fade-in-down 0.8s ease-out forwards;
    opacity: 0;
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
    opacity: 0;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  .typewriter-cursor {
    display: inline-block;
    color: #00bfff;
    animation: blink 0.75s step-end infinite;
    font-weight: 300;
    margin-left: 1px;
  }

  @keyframes bounce-down {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(8px);
      opacity: 0.6;
    }
  }
  @keyframes bounce-down-delayed {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    50% {
      transform: translateY(8px);
      opacity: 0.15;
    }
  }
  .scroll-label {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-weight: 600;
    color: #00bfff;
    text-shadow: 0 0 10px rgba(0, 191, 255, 0.7);
  }
  .scroll-arrow {
    animation: bounce-down 1.5s ease-in-out infinite;
    filter: drop-shadow(0 0 6px rgba(0, 191, 255, 0.9))
      drop-shadow(0 0 14px rgba(0, 191, 255, 0.5));
  }
  .scroll-arrow--delayed {
    animation: bounce-down-delayed 1.5s ease-in-out infinite;
    animation-delay: 0.2s;
    margin-top: -10px;
  }
  #scroll-hint {
    opacity: 1;
    transition: opacity 0.5s ease;
  }
  #scroll-hint.hidden-hint {
    opacity: 0;
    pointer-events: none;
  }

  /* Fallback si no carga la foto */
  .photo-fallback {
    background: linear-gradient(
      135deg,
      rgba(0, 191, 255, 0.1),
      rgba(0, 191, 255, 0.05)
    );
  }

  @keyframes name-glow {
    0%,
    100% {
      text-shadow:
        0 0 10px rgba(0, 191, 255, 0),
        0 0 20px rgba(0, 191, 255, 0);
    }
    50% {
      text-shadow:
        0 0 12px rgba(0, 191, 255, 0.7),
        0 0 30px rgba(0, 191, 255, 0.4),
        0 0 60px rgba(0, 191, 255, 0.15);
    }
  }

  .name-glow {
    animation:
      fade-in-down 0.8s ease-out forwards,
      name-glow 3s ease-in-out infinite;
    animation-delay: 200ms, 1200ms;
  }

  @keyframes orb-float {
    0%,
    100% {
      transform: translateY(0px) translateX(0px);
      opacity: 0.4;
    }
    25% {
      transform: translateY(-12px) translateX(6px);
      opacity: 0.8;
    }
    50% {
      transform: translateY(-6px) translateX(-4px);
      opacity: 0.5;
    }
    75% {
      transform: translateY(-16px) translateX(8px);
      opacity: 0.7;
    }
  }

  .orb-float {
    animation: orb-float 6s ease-in-out infinite;
  }
</style>

<script>
  const PHRASES = [
    "Full Stack Developer",
    "Full Stack Developer | Angular & Spring Boot",
    "Full Stack Developer | Microservicios & Docker",
    "Full Stack Developer | APIs REST & GraphQL",
    "Full Stack Developer | Java & TypeScript",
  ];

  const TYPE_SPEED = 70;
  const DELETE_SPEED = 35;
  const PAUSE_AFTER = 2200;
  const PAUSE_BEFORE = 300;

  const el = document.getElementById("typewriter")!;
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function sharedPrefix(a: string, b: string): number {
    let i = 0;
    while (i < a.length && i < b.length && a[i] === b[i]) i++;
    return i;
  }

  function type() {
    const current = PHRASES[phraseIndex];
    const next = PHRASES[(phraseIndex + 1) % PHRASES.length];
    const keepUntil = sharedPrefix(current, next);

    if (!isDeleting) {
      el.textContent = current.slice(0, charIndex + 1);
      charIndex++;
      if (charIndex === current.length) {
        isDeleting = true;
        setTimeout(type, PAUSE_AFTER);
        return;
      }
      setTimeout(type, TYPE_SPEED);
    } else {
      el.textContent = current.slice(0, charIndex - 1);
      charIndex--;
      if (charIndex <= keepUntil) {
        isDeleting = false;
        phraseIndex = (phraseIndex + 1) % PHRASES.length;
        setTimeout(type, PAUSE_BEFORE);
        return;
      }
      setTimeout(type, DELETE_SPEED);
    }
  }

  setTimeout(type, 500);

  const hint = document.getElementById("scroll-hint")!;
  window.addEventListener(
    "scroll",
    () => {
      hint.classList.toggle("hidden-hint", window.scrollY > 80);
    },
    { passive: true },
  );
</script>
