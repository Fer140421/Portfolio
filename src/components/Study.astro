<style>
  @keyframes edu-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  .edu-cursor {
    display: inline-block;
    color: #00bfff;
    animation: edu-blink 0.75s step-end infinite;
    font-weight: 300;
    margin-left: 1px;
    transition: opacity 0.4s ease;
  }
  .edu-cursor.done {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const TEXT = "Educacion";
  const TYPE_SPEED = 90;
  const el = document.getElementById("edu-typewriter")!;
  const cursor = document.getElementById("edu-cursor")!;
  let typed = false;

  function typeTitle() {
    if (typed) return;
    typed = true;
    let i = 0;
    function step() {
      if (i < TEXT.length) {
        el.textContent = TEXT.slice(0, i + 1);
        i++;
        setTimeout(step, TYPE_SPEED);
      } else {
        setTimeout(() => cursor.classList.add("done"), 600);
      }
    }
    step();
  }

  const section = document.getElementById("educacion")!;
  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) {
        typeTitle();
        observer.disconnect();
      }
    },
    { threshold: 0.2 },
  );
  observer.observe(section);

  const extra = document.getElementById("extra-courses")!;
  const btn = document.getElementById("toggle-courses")!;
  const label = document.getElementById("toggle-label")!;
  const icon = document.getElementById("toggle-icon")!;
  let open = false;

  btn.addEventListener("click", () => {
    open = !open;
    extra.style.maxHeight = open ? extra.scrollHeight + "px" : "0";
    label.textContent = open ? "Ver menos" : "Ver más";
    icon.style.transform = open ? "rotate(180deg)" : "rotate(0deg)";
  });
</script>
